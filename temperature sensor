import time
import board
import digitalio
import adafruit_dht
from datetime import datetime

# Initialize DHT11 Sensor on GPIO 16 (board.D16)
sensor = adafruit_dht.DHT11(board.D16)

# Setup Red LED on GPIO 20 (board.D20) - update pin if needed
red_led = digitalio.DigitalInOut(board.D20)
red_led.direction = digitalio.Direction.OUTPUT

# Setup Blue LED on GPIO 21 (board.D21) - update pin if needed
blue_led = digitalio.DigitalInOut(board.D21)
blue_led.direction = digitalio.Direction.OUTPUT

print("time,celsius,fahrenheit")

def to_fahrenheit(c):
    # Fahrenheit conversion formula: (C * 9/5) + 32
    f = (c * 9 / 5) + 32
    return f 

while True:
    try:
        celsius = sensor.temperature # Get temperature in Celsius
        fahrenheit = to_fahrenheit(celsius)
        current_time = datetime.now()
        print("{0},{1:0.1f},{2:0.1f}".format(current_time.strftime("%H:%M:%S"), celsius, fahrenheit))

        # Control LEDs based on temperature threshold (72°F)
        if fahrenheit > 72:
            red_led.value = True
            blue_led.value = False
        else:
            red_led.value = False
            blue_led.value = True

        time.sleep(3.0)
    except RuntimeError as error:
        # Errors happen fairly often; DHT sensors can be tricky to read
        print(error.args[0])
        time.sleep(2.0)
        continue
    except Exception as error:
        # Turn off LEDs when exiting on an error
        red_led.value = False
        blue_led.value = False
        sensor.exit()
        raise error
